# Copy to .env.local and fill in. Nothing here is needed for `npm run dev`
# in demo mode (DEMO_MODE=1), which is how the quickstart runs.

# --- Demo mode ------------------------------------------------------------
# One-tap sign-in as the athlete or the coach, 60 days of synthetic history,
# and fixture readers in place of every model call. No keys needed.
# DEMO_MODE=1

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL unset to use the embedded PGlite database at .data/pglite
# (local dev and tests). Set it to a Postgres (Neon) URL for production.
# DATABASE_URL=<postgres connection string>
# PGLITE_DIR=memory://   keeps PGlite in memory (the hosted demo does this)

# --- Auth -----------------------------------------------------------------
# Random 32+ char secret: `openssl rand -base64 32`
AUTH_SECRET=change-me

# Passphrase sign-in for a real deployment. Long and random.
SITE_PASSPHRASE=change-me-to-a-long-random-passphrase
# Separate passphrase for coach accounts. Required in production for a coach
# to sign in with a passphrase; in development it falls back to SITE_PASSPHRASE.
# COACH_PASSPHRASE=

# Optional Google sign-in. Redirect URI: https://<your-domain>/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Comma-separated emails allowed to sign in with Google.
# ALLOWED_EMAILS=athlete@example.com,coach@example.com

# --- Model calls ----------------------------------------------------------
# The nutrition label reader and the restaurant menu finder call Claude.
# Unset, demo mode answers from fixtures.
# ANTHROPIC_API_KEY=

# --- Open Food Facts (barcode fallback) -----------------------------------
# OFF asks for an identifying User-Agent.
# OFF_USER_AGENT=SlateTracker/0.1 (+https://example.com)

# --- Display name ---------------------------------------------------------
# What users see in the title, login screen, manifest and home-screen label.
# Internal keys stay "slate" regardless. Build-time, so a change needs a redeploy.
NEXT_PUBLIC_APP_NAME=Slate

# --- Timezone -------------------------------------------------------------
# Calendar dates and go-to hours are computed in this zone on server and client.
# Vercel runs in UTC and reserves the TZ variable, so this is the only knob.
NEXT_PUBLIC_APP_TZ=America/New_York
